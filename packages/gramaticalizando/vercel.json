{
  "version": 2,
  "name": "gramaticalizando",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/pages/login(.html)?", "destination": "/login", "permanent": true },
    { "source": "/pages/registro(.html)?", "destination": "/registro", "permanent": true },
    { "source": "/pages/cadastro(.html)?", "destination": "/registro", "permanent": true },
    { "source": "/pages/home(.html)?", "destination": "/home", "permanent": true },
    { "source": "/pages/diagnostico(.html)?", "destination": "/diagnostico", "permanent": true },
    { "source": "/pages/portugues(.html)?", "destination": "/portugues", "permanent": true },
    { "source": "/pages/portugues-conteudo(.html)?", "destination": "/portugues-conteudo", "permanent": true },
    { "source": "/pages/redacao(.html)?", "destination": "/redacao", "permanent": true },
    { "source": "/pages/videoaulas(.html)?", "destination": "/videoaulas", "permanent": true },
    { "source": "/pages/simulados(.html)?", "destination": "/simulados", "permanent": true },
    { "source": "/pages/simulado-conteudo(.html)?", "destination": "/simulado-conteudo", "permanent": true },
    { "source": "/pages/materiais(.html)?", "destination": "/materiais", "permanent": true },
    { "source": "/pages/cronograma(.html)?", "destination": "/cronograma", "permanent": true },
    { "source": "/pages/perfil(.html)?", "destination": "/perfil", "permanent": true },
    { "source": "/pages/configuracoes(.html)?", "destination": "/configuracoes", "permanent": true },
    { "source": "/professor/index(.html)?", "destination": "/professor", "permanent": true },
    { "source": "/professor/:page.html", "destination": "/professor/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/registro", "destination": "/pages/registro.html" },
    { "source": "/cadastro", "destination": "/pages/registro.html" },
    { "source": "/home", "destination": "/pages/home.html" },
    { "source": "/aluno", "destination": "/pages/home.html" },
    { "source": "/diagnostico", "destination": "/pages/diagnostico.html" },
    { "source": "/portugues", "destination": "/pages/portugues.html" },
    { "source": "/portugues-conteudo", "destination": "/pages/portugues-conteudo.html" },
    { "source": "/redacao", "destination": "/pages/redacao.html" },
    { "source": "/videoaulas", "destination": "/pages/videoaulas.html" },
    { "source": "/simulados", "destination": "/pages/simulados.html" },
    { "source": "/simulado-conteudo", "destination": "/pages/simulado-conteudo.html" },
    { "source": "/materiais", "destination": "/pages/materiais.html" },
    { "source": "/material", "destination": "/pages/materiais.html" },
    { "source": "/cronograma", "destination": "/pages/cronograma.html" },
    { "source": "/perfil", "destination": "/pages/perfil.html" },
    { "source": "/configuracoes", "destination": "/pages/configuracoes.html" },
    { "source": "/professor", "destination": "/professor/index.html" },
    { "source": "/professor/:page", "destination": "/professor/:page.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/pages/:page", "destination": "/pages/:page.html" }
  ]
}
