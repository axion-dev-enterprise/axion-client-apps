{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/aluno", "destination": "/home" },
    { "source": "/cadastro", "destination": "/registro" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
